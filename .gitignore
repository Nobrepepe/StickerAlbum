.venv/
__pycache__/
*.pyc
.pytest_cache/
app_data/
.claude/settings.local.json
.claude/launch.json

# Collection art and voice lines are imported through the Creator and backed
# up outside the repo — keeping them here made every version gigabytes wide.
# Only the app's own cues and the naming conventions stay tracked; anything
# missing renders as a styled placeholder.
assets/*
!assets/README.txt
!assets/fonts/
!assets/fonts/*.ttf
!assets/fonts/*-OFL.txt
!assets/sounds/
assets/sounds/*
!assets/sounds/stamp.wav
!assets/sounds/tear.wav
!assets/sounds/reveal.wav
!assets/sounds/new.wav
